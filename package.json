{
  "name": "luxedrive",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "db:backup": "./scripts/backup.sh",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "postinstall": "prisma generate",
    "db:smoke": "node scripts/db-smoke.mjs",
    "db:seed-demo-catalog": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-demo-catalog.mts",
    "db:migrate-media": "NODE_OPTIONS=--conditions=react-server tsx scripts/migrate-media.mts",
    "db:seed-storefront-demo": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-storefront-demo.mts",
    "db:create-admin": "NODE_OPTIONS=--conditions=react-server tsx scripts/create-admin.mts",
    "db:deploy:managed": "node scripts/migrate-deploy.mjs",
    "db:bootstrap-admin": "NODE_OPTIONS=--conditions=react-server tsx scripts/bootstrap-admin-if-absent.mts",
    "vercel-build": "pnpm db:deploy:managed && pnpm db:bootstrap-admin && next build",
    "db:cleanup-e2e-content": "NODE_OPTIONS=--conditions=react-server tsx scripts/cleanup-e2e-content.mts",
    "db:seed-e2e-admins": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-e2e-admins.mts",
    "db:seed-e2e-orders": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-e2e-orders-fixture.mts",
    "db:seed-e2e-account": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-e2e-account-fixture.mts",
    "payments:stub": "node scripts/payment-provider-stub.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "^7.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.38.0",
    "next": "^16.3.4",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/smtp-server": "^3.5.13",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16",
    "eslint-import-resolver-typescript": "^4",
    "eslint-plugin-boundaries": "^5",
    "eslint-plugin-import": "^2",
    "mailparser": "^3.9.20",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prisma": "7.10.0",
    "smtp-server": "^3.19.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "unrs-resolver",
      "@tailwindcss/oxide",
      "sharp"
    ]
  }
}
