// LuxeDrive — data model.
//
// This schema is the one approved in the Final ADR (section 03). It is
// declarative only: no business logic lives here, and later phases add
// services and UI on top of it rather than reshaping core relations.
//
// Conventions
//  - Money is always an integer in the currency's minor unit (halalas for
//    SAR). Fields are suffixed `Minor` rather than `Cents` because the store
//    currency is configurable (ADR-006, ADR-022, ADR-015).
//  - Tables and columns are snake_case; Prisma models stay PascalCase.
//  - Bilingual content is stored as explicit `...Ar` / `...En` columns so both
//    languages are first class rather than one being a translation table.

generator client {
  provider = "prisma-client-js"
  // Generated into the repository rather than node_modules: pnpm's symlinked
  // store means the default location is not resolvable from application code.
  // The directory is gitignored and regenerated by `pnpm db:generate`.
  output   = "../generated/prisma"
}

// Connection URLs live in prisma.config.ts as of Prisma 7.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  STAFF
  MANAGER
  OWNER
}

enum Locale {
  AR
  EN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttributeType {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  BOOLEAN
}

/// Where the order is in its commercial life. Two entry states, one
/// downstream path (ADR-025): online orders start at PENDING_PAYMENT;
/// WhatsApp and admin-created orders start at PENDING_MANUAL_CONFIRMATION
/// and require a permissioned staff confirmation.
///
/// P10 split what used to be one enum into three (P10 §9). SHIPPED and
/// DELIVERED moved to `FulfillmentStatus` and REFUNDED to `PaymentStatus`,
/// because an order that is paid, cancelled and refunded needs to say all
/// three things at once — a single column can only ever say one. No order
/// data existed when this changed.
enum OrderStatus {
  PENDING_PAYMENT
  PENDING_MANUAL_CONFIRMATION
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

/// Has the money arrived? Owned by the payment domain; P10 only ever sets
/// UNPAID (no provider exists yet), and P11's webhooks drive the rest.
enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

/// What kind of change an `OrderEvent` records. Kept generic so all three
/// state machines, plus creation and free-text notes, share one timeline
/// rather than each growing its own history table.
enum OrderEventType {
  CREATED
  ORDER_STATUS
  PAYMENT_STATUS
  FULFILLMENT_STATUS
  NOTE
}

/// Reporting only — never used to branch pricing, inventory or permission rules.
enum OrderSource {
  ONLINE
  WHATSAPP
  ADMIN
}

/// Which adapter handled a payment. P11 ships one implementation —
/// HOSTED_CHECKOUT, a provider-agnostic redirect/hosted-page contract driven
/// entirely by environment configuration. The named vendors are the extension
/// points: adding one means writing a file that implements `PaymentProvider`
/// and adding its value here, with no change to the order domain.
enum PaymentProvider {
  MANUAL
  HOSTED_CHECKOUT
  PAYMOB
  TAP
  STRIPE
}

/// The lifecycle of ONE payment attempt — deliberately not `PaymentStatus`.
///
/// `Order.paymentStatus` answers "has this order been paid", which is a
/// roll-up across every attempt. This answers "what happened to this
/// session", which is a different question: an order can hold a FAILED
/// attempt and a SUCCEEDED one at once, and UNPAID is meaningless for a row
/// that exists precisely because someone tried (P11 §3).
///
/// CREATED       a provider session exists; the customer has not acted
/// REQUIRES_ACTION the provider needs the customer (3-D Secure, OTP)
/// PENDING       the provider has it and the outcome is not yet known
/// SUCCEEDED     verified server-side. Never set from a browser redirect.
/// FAILED        the provider declined it
/// CANCELLED     the customer or the store abandoned it
/// EXPIRED       the session outlived its window without an outcome
enum PaymentAttemptStatus {
  CREATED
  REQUIRES_ACTION
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

/// UNPAID is the resting state of an order nobody has tried to pay yet — the
/// only value P10 ever writes, because P10 has no payment provider. PENDING
/// means a provider session is open and its outcome is not known; P11 owns
/// every transition out of it.
enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum InventoryReason {
  SALE
  CANCELLATION
  RETURN
  MANUAL
  DAMAGED
  RESTOCK
  CORRECTION
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum CouponScopeType {
  PRODUCT
  CATEGORY
  BRAND
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum HomepageSectionType {
  HERO
  BANNER
  FEATURED_CATEGORIES
  FEATURED_PRODUCTS
  NEW_ARRIVALS
  BEST_SELLERS
  ACTIVE_OFFERS
  TESTIMONIALS
  TRUST_BLOCKS
  CUSTOM_PROMO
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum OutboxStatus {
  PENDING
  /// P13: a worker has claimed this row and is actively attempting delivery.
  /// The claim itself is the atomic transition PENDING -> SENDING (only one
  /// concurrent `UPDATE ... WHERE status = 'PENDING'` can win it) — see
  /// `src/lib/notifications/email-dispatcher.ts`. A row never lingers here
  /// under normal operation: it always leaves for PENDING (retry), SENT, or
  /// FAILED within the same request that claimed it.
  SENDING
  SENT
  FAILED
}

enum SlugEntityType {
  PRODUCT
  CATEGORY
  BRAND
}

/// Which storage backend actually holds the bytes. EXTERNAL is a transitional
/// state, not a real backend: it's what a MediaAsset created by referencing a
/// URL nobody has downloaded yet looks like (ADR-010/P04) — the P03 car
/// migration created rows this way, and P04's own migration script flips
/// them to a real provider. Nothing in the app should treat EXTERNAL as a
/// long-term destination.
enum StorageProvider {
  S3
  LOCAL
  EXTERNAL
}

// ---------------------------------------------------------------------------
// identity
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  name            String?
  role            Role      @default(CUSTOMER)
  locale          Locale    @default(AR)
  active          Boolean   @default(true)
  /// Null means unverified. P12 builds the whole verification domain — a
  /// random single-use token, expiry, server-side confirmation — but does
  /// not gate login or checkout on this being set: P13 owns actually
  /// sending the email, and making verification mandatory before P13 exists
  /// would leave a registered customer with no way to ever pass the gate.
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions                Session[]
  customer                Customer?
  auditLogs               AuditLog[]
  orderEvents             OrderEvent[]
  inventoryAdjustments    InventoryAdjustment[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@index([role])
  @@map("users")
}

/// A pending "confirm this address" link (P12 §12). Hashed at rest — the
/// same posture `Session.tokenHash` and `Order.accessTokenHash` already
/// apply — so a database read alone can never confirm someone's email.
/// `usedAt` makes replay fail: a token that already succeeded once is a
/// permanent no, not merely an expired one.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// A password-reset link (P12 §13). Same hashed-at-rest, single-use,
/// expiring shape as `EmailVerificationToken` — kept as its own model
/// rather than one shared "token" table because the two mean different
/// things (proving an address vs. proving account recovery) and a reset
/// token additionally has to survive being looked up by an attacker probing
/// random values without that lookup itself becoming an oracle, which is
/// the service layer's job, not the schema's.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// media
// ---------------------------------------------------------------------------

/// Generic from day one (ADR-010): products, banners and homepage sections all
/// reference the same assets rather than each owning its own image system.
model MediaAsset {
  id          String          @id @default(uuid()) @db.Uuid
  provider    StorageProvider @default(EXTERNAL)
  storageKey  String          @unique @map("storage_key")
  /// SHA-256 of the actual bytes, computed server-side after upload — never
  /// trusted from the client. Nullable because it can't be backfilled for a
  /// row created before the bytes were ever fetched (EXTERNAL, pre-P04); a
  /// unique index (not constraint — Postgres allows multiple NULLs) is what
  /// makes "does this exact file already exist" a single indexed lookup
  /// instead of a table scan, for both `confirmUpload` and the media
  /// migration script (ADR: content-hash dedup).
  contentHash String?         @unique @map("content_hash")
  mime        String
  sizeBytes   Int             @map("size_bytes")
  width       Int?
  height      Int?
  altAr       String?         @map("alt_ar")
  altEn       String?         @map("alt_en")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at")

  productImages  ProductImage[]
  categoryImages Category[]
  brandLogos     Brand[]

  @@map("media_assets")
}

// ---------------------------------------------------------------------------
// catalog
// ---------------------------------------------------------------------------

model Category {
  id               String   @id @default(uuid()) @db.Uuid
  parentId         String?  @map("parent_id") @db.Uuid
  slug             String   @unique
  nameAr           String   @map("name_ar")
  nameEn           String   @map("name_en")
  descriptionAr    String?  @map("description_ar")
  descriptionEn    String?  @map("description_en")
  imageMediaId     String?  @map("image_media_id") @db.Uuid
  position         Int      @default(0)
  seoTitleAr       String?  @map("seo_title_ar")
  seoTitleEn       String?  @map("seo_title_en")
  seoDescriptionAr String?  @map("seo_description_ar")
  seoDescriptionEn String?  @map("seo_description_en")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  parent     Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]            @relation("CategoryTree")
  image      MediaAsset?           @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)
  products   Product[]
  attributes AttributeDefinition[]

  @@index([parentId])
  @@index([position])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  nameAr      String   @map("name_ar")
  nameEn      String   @map("name_en")
  logoMediaId String?  @map("logo_media_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  logo     MediaAsset? @relation(fields: [logoMediaId], references: [id], onDelete: SetNull)
  products Product[]

  @@map("brands")
}

/// Attributes are defined by the store owner per category, not by a developer
/// (Blueprint 08). Child categories inherit their parent's definitions.
model AttributeDefinition {
  id            String        @id @default(uuid()) @db.Uuid
  categoryId    String        @map("category_id") @db.Uuid
  key           String
  labelAr       String        @map("label_ar")
  labelEn       String        @map("label_en")
  type          AttributeType
  unit          String?
  allowedValues Json?         @map("allowed_values")
  required      Boolean       @default(false)
  filterable    Boolean       @default(false)
  displayOrder  Int           @default(0) @map("display_order")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, key])
  @@index([categoryId, displayOrder])
  @@map("attribute_definitions")
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  slug             String        @unique
  nameAr           String        @map("name_ar")
  nameEn           String        @map("name_en")
  descriptionAr    String?       @map("description_ar")
  descriptionEn    String?       @map("description_en")
  status           ProductStatus @default(DRAFT)
  featured         Boolean       @default(false)
  categoryId       String        @map("category_id") @db.Uuid
  brandId          String?       @map("brand_id") @db.Uuid
  /// Category-defined descriptive attributes, validated on write against the
  /// category's AttributeDefinition set (ADR-004).
  attributes       Json          @default("{}")
  seoTitleAr       String?       @map("seo_title_ar")
  seoTitleEn       String?       @map("seo_title_en")
  seoDescriptionAr String?       @map("seo_description_ar")
  seoDescriptionEn String?       @map("seo_description_en")
  publishedAt      DateTime?     @map("published_at")
  /// Soft delete with a recovery window (ADR-021).
  deletedAt        DateTime?     @map("deleted_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  category      Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand         Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images        ProductImage[]
  options       ProductOption[]
  variants      Variant[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  views         ProductView[]
  dailyStats    DailyProductStats[]

  @@index([categoryId, status])
  @@index([brandId])
  @@index([status, publishedAt])
  @@index([deletedAt])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  mediaId   String  @map("media_id") @db.Uuid
  position  Int     @default(0)
  isPrimary Boolean @default(false) @map("is_primary")

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaId])
  @@index([productId, position])
  @@map("product_images")
}

model ProductOption {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  nameAr    String @map("name_ar")
  nameEn    String @map("name_en")
  position  Int    @default(0)

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  OptionValue[]

  @@unique([productId, nameEn])
  @@map("product_options")
}

model OptionValue {
  id       String @id @default(uuid()) @db.Uuid
  optionId String @map("option_id") @db.Uuid
  valueAr  String @map("value_ar")
  valueEn  String @map("value_en")
  position Int    @default(0)

  option        ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variantValues VariantOptionValue[]

  @@unique([optionId, valueEn])
  @@map("option_values")
}

/// Price and stock always live on the variant, even for a simple product with
/// no options, so there is one pricing path rather than two (ADR-005).
model Variant {
  id                String    @id @default(uuid()) @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  sku               String    @unique
  labelAr           String?   @map("label_ar")
  labelEn           String?   @map("label_en")
  priceMinor        Int       @map("price_minor")
  compareAtMinor    Int?      @map("compare_at_minor")
  salePriceMinor    Int?      @map("sale_price_minor")
  saleStartsAt      DateTime? @map("sale_starts_at")
  saleEndsAt        DateTime? @map("sale_ends_at")
  stockQuantity     Int       @default(0) @map("stock_quantity")
  lowStockThreshold Int       @default(0) @map("low_stock_threshold")
  trackInventory    Boolean   @default(true) @map("track_inventory")
  weightGrams       Int?      @map("weight_grams")
  position          Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  product      Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues VariantOptionValue[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  adjustments  InventoryAdjustment[]

  @@index([productId])
  @@index([stockQuantity])
  @@map("variants")
}

model VariantOptionValue {
  variantId     String @map("variant_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  variant     Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue OptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@map("variant_option_values")
}

/// Renaming a product must not cost its search ranking (Blueprint 23).
model SlugRedirect {
  id         String         @id @default(uuid()) @db.Uuid
  entityType SlugEntityType @map("entity_type")
  oldSlug    String         @map("old_slug")
  newSlug    String         @map("new_slug")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@unique([entityType, oldSlug])
  @@map("slug_redirects")
}

// ---------------------------------------------------------------------------
// inventory
// ---------------------------------------------------------------------------

/// Every stock movement is explainable: what changed, from what to what, why,
/// by whom, and against which order (ADR-019).
model InventoryAdjustment {
  id               String          @id @default(uuid()) @db.Uuid
  variantId        String          @map("variant_id") @db.Uuid
  delta            Int
  previousQuantity Int             @map("previous_quantity")
  newQuantity      Int             @map("new_quantity")
  reason           InventoryReason
  actorUserId      String?         @map("actor_user_id") @db.Uuid
  orderId          String?         @map("order_id") @db.Uuid
  note             String?
  createdAt        DateTime        @default(now()) @map("created_at")

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  actor   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([orderId])
  @@map("inventory_adjustments")
}

// ---------------------------------------------------------------------------
// customers
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses     Address[]
  carts         Cart[]
  orders        Order[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  redemptions   CouponRedemption[]

  @@map("customers")
}

model Address {
  id         String      @id @default(uuid()) @db.Uuid
  customerId String      @map("customer_id") @db.Uuid
  type       AddressType @default(SHIPPING)
  fullName   String      @map("full_name")
  phone      String
  city       String
  district   String?
  line1      String
  line2      String?
  postalCode String?     @map("postal_code")
  country    String      @default("SA")
  isDefault  Boolean     @default(false) @map("is_default")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, type])
  @@map("addresses")
}

model Review {
  id         String       @id @default(uuid()) @db.Uuid
  productId  String       @map("product_id") @db.Uuid
  customerId String       @map("customer_id") @db.Uuid
  rating     Int
  title      String?
  body       String?
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([productId, customerId])
  @@index([productId, status])
  @@map("reviews")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------------
// cart
// ---------------------------------------------------------------------------

model Cart {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String?  @map("customer_id") @db.Uuid
  /// Long random token for guest carts, kept in an httpOnly cookie.
  guestToken String?  @unique @map("guest_token")
  /// The promotion code the customer entered, stored normalised. Deliberately
  /// the code rather than a foreign key: a cart guarantees nothing about
  /// price or eligibility, and every read re-resolves the coupon and
  /// re-checks it from scratch (P09 §16). Holding an id would imply the
  /// promotion attached to this cart is still valid, which is exactly the
  /// thing that must never be assumed.
  couponCode String?  @map("coupon_code")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@index([customerId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// pricing / promotions
// ---------------------------------------------------------------------------

model Coupon {
  id               String     @id @default(uuid()) @db.Uuid
  code             String     @unique
  type             CouponType
  /// Percentage points for PERCENTAGE, minor units for FIXED.
  value            Int
  descriptionAr    String?    @map("description_ar")
  descriptionEn    String?    @map("description_en")
  minOrderMinor    Int?       @map("min_order_minor")
  maxDiscountMinor Int?       @map("max_discount_minor")
  usageLimit       Int?       @map("usage_limit")
  perCustomerLimit Int?       @map("per_customer_limit")
  usedCount        Int        @default(0) @map("used_count")
  startsAt         DateTime?  @map("starts_at")
  endsAt           DateTime?  @map("ends_at")
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  scopes      CouponScope[]
  redemptions CouponRedemption[]
  orders      Order[]

  @@index([active, endsAt])
  @@map("coupons")
}

/// No rows means the coupon applies to everything.
model CouponScope {
  id        String          @id @default(uuid()) @db.Uuid
  couponId  String          @map("coupon_id") @db.Uuid
  scopeType CouponScopeType @map("scope_type")
  targetId  String          @map("target_id") @db.Uuid

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, scopeType, targetId])
  @@map("coupon_scopes")
}

/// Per-customer limits are enforced by these rows, not by an in-memory counter.
model CouponRedemption {
  id         String   @id @default(uuid()) @db.Uuid
  couponId   String   @map("coupon_id") @db.Uuid
  customerId String?  @map("customer_id") @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  coupon   Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId, customerId])
  @@map("coupon_redemptions")
}

// ---------------------------------------------------------------------------
// orders
// ---------------------------------------------------------------------------

model Order {
  id                  String            @id @default(uuid()) @db.Uuid
  /// Customer-facing identifier. Random, not sequential: a sequential number
  /// leaks how many orders the store has taken and makes a neighbouring
  /// order trivially guessable (P10 §2).
  number              String            @unique
  customerId          String?           @map("customer_id") @db.Uuid
  status              OrderStatus
  paymentStatus       PaymentStatus     @default(UNPAID) @map("payment_status")
  fulfillmentStatus   FulfillmentStatus @default(UNFULFILLED) @map("fulfillment_status")
  source              OrderSource       @default(ONLINE)
  subtotalMinor       Int               @map("subtotal_minor")
  discountMinor       Int               @default(0) @map("discount_minor")
  /// Zero and not calculated in P10 — no shipping or tax engine exists yet
  /// (P10 §21). The columns are here so adding one later is a service
  /// change, not a schema migration on a table full of live orders.
  shippingMinor       Int               @default(0) @map("shipping_minor")
  taxMinor            Int               @default(0) @map("tax_minor")
  totalMinor          Int               @map("total_minor")
  currency            String            @default("SAR")
  couponId            String?           @map("coupon_id") @db.Uuid
  /// The code as typed at checkout. Kept even if the coupon row is later
  /// deleted, so the order still explains its own discount.
  couponCode          String?           @map("coupon_code")
  /// Address snapshots, so an order stays correct if the customer edits or
  /// deletes the address it was placed with. Shape is validated by
  /// `shippingAddressSchema` in the orders module before it is written.
  shippingAddress     Json?             @map("shipping_address")
  billingAddress      Json?             @map("billing_address")
  contactName         String?           @map("contact_name")
  customerEmail       String?           @map("customer_email")
  customerPhone       String?           @map("customer_phone")
  note                String?
  /// Guest access credential, hashed the same way session tokens are: the
  /// plaintext exists only in the customer's URL and cookie, never at rest,
  /// so a database read cannot open somebody's order (P10 §14).
  accessTokenHash     String?           @unique @map("access_token_hash")
  /// Server-side duplicate-submission guard (P10 §19). Unique, so two
  /// concurrent submissions of the same checkout collide in the database
  /// rather than racing past an application-level check.
  idempotencyKey      String?           @unique @map("idempotency_key")
  /// Set once, when cancellation restores stock. Its presence is what makes
  /// a repeated cancellation a no-op instead of a second restock (P10 §18).
  inventoryRestoredAt DateTime?         @map("inventory_restored_at")
  confirmedAt         DateTime?         @map("confirmed_at")
  cancelledAt         DateTime?         @map("cancelled_at")
  cancellationReason  String?           @map("cancellation_reason")
  placedAt            DateTime          @default(now()) @map("placed_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  customer    Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  coupon      Coupon?               @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  events      OrderEvent[]
  payments    Payment[]
  shipments   Shipment[]
  adjustments InventoryAdjustment[]
  redemptions CouponRedemption[]

  @@index([customerId, placedAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([source, status])
  @@index([placedAt])
  @@map("orders")
}

/// Snapshot columns keep historical invoices correct no matter what happens to
/// the product later, including deletion (ADR-007).
model OrderItem {
  id                     String  @id @default(uuid()) @db.Uuid
  orderId                String  @map("order_id") @db.Uuid
  /// References, for "buy it again" and reporting. Nullable and SetNull on
  /// delete: the snapshot columns below are what actually renders the line,
  /// so a deleted product leaves the invoice fully readable (P10 §3).
  variantId              String? @map("variant_id") @db.Uuid
  productId              String? @map("product_id") @db.Uuid
  /// Snapshots. Bilingual because the order confirmation, the account page
  /// and the admin screen each render in whichever language their reader
  /// chose — resolving one language at write time would strand the other.
  productNameArSnapshot  String  @map("product_name_ar_snapshot")
  productNameEnSnapshot  String  @map("product_name_en_snapshot")
  variantLabelArSnapshot String? @map("variant_label_ar_snapshot")
  variantLabelEnSnapshot String? @map("variant_label_en_snapshot")
  skuSnapshot            String  @map("sku_snapshot")
  /// The selected options as chosen, e.g. [{nameAr, nameEn, valueAr, valueEn}].
  optionsSnapshot        Json?   @map("options_snapshot")
  unitPriceMinor         Int     @map("unit_price_minor")
  quantity               Int
  lineSubtotalMinor      Int     @map("line_subtotal_minor")
  lineDiscountMinor      Int     @default(0) @map("line_discount_minor")
  lineTotalMinor         Int     @map("line_total_minor")
  currency               String  @default("SAR")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

/// Every status transition is recorded with who did it and when (ADR-025).
model OrderEvent {
  id          String         @id @default(uuid()) @db.Uuid
  orderId     String         @map("order_id") @db.Uuid
  type        OrderEventType
  /// Enum values as strings, because one timeline carries three different
  /// state machines. The service layer is typed; the column is not, which is
  /// the price of a single ordered history instead of three interleaved ones.
  fromValue   String?        @map("from_value")
  toValue     String?        @map("to_value")
  /// Null when the actor is the system: an order the customer placed, or a
  /// transition a future payment webhook drives.
  actorUserId String?        @map("actor_user_id") @db.Uuid
  note        String?
  createdAt   DateTime       @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_events")
}

// ---------------------------------------------------------------------------
// payments
// ---------------------------------------------------------------------------

/// ONE payment attempt against one order (P11 §17).
///
/// An order holds a list of these, never a single mutable row: a declined
/// attempt followed by a successful retry has to leave both facts standing,
/// and overwriting the first destroys the audit trail the store needs when a
/// customer says they were charged twice.
///
/// Amount and currency are copied from the order at creation and are the
/// values sent to the provider. They are never read from a request body —
/// see `payment-flow.service.ts` (P11 §7).
model Payment {
  id                String               @id @default(uuid()) @db.Uuid
  orderId           String               @map("order_id") @db.Uuid
  provider          PaymentProvider
  /// The provider's own id for this session/intent. Not an authorization
  /// credential: knowing it proves nothing and grants nothing — every read
  /// path resolves the order first and checks ownership (P11 §9).
  providerReference String?              @map("provider_reference")
  status            PaymentAttemptStatus @default(CREATED)
  amountMinor       Int                  @map("amount_minor")
  currency          String               @default("SAR")
  /// Server-generated, unique. Two concurrent "start payment" clicks collide
  /// here in the database rather than racing past an application check —
  /// the same mechanism P10 used for checkout (P11 §8).
  idempotencyKey    String               @unique @map("idempotency_key")
  /// Where to send the customer. Provider-issued; never a store URL.
  checkoutUrl       String?              @map("checkout_url")
  /// Provider's own decline code and message, kept for support and
  /// reconciliation. Never a secret, never a raw payload.
  failureCode       String?              @map("failure_code")
  failureMessage    String?              @map("failure_message")
  /// A redacted projection of the provider payload — allowlisted keys only
  /// (`redactProviderPayload`). The raw body is never stored: it can carry a
  /// cardholder name, a full PAN echo, or an auth token (P11 §2).
  providerMetadata  Json?                @map("provider_metadata")
  /// When the provider session stops being usable. Drives EXPIRED.
  expiresAt         DateTime?            @map("expires_at")
  /// Monotonic guard against out-of-order webhook delivery: an event older
  /// than the one already applied is ignored rather than allowed to regress
  /// the attempt (P11 §12).
  lastEventAt       DateTime?            @map("last_event_at")
  paidAt            DateTime?            @map("paid_at")
  failedAt          DateTime?            @map("failed_at")
  cancelledAt       DateTime?            @map("cancelled_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  webhookEvents WebhookEvent[]

  @@unique([provider, providerReference])
  @@index([orderId, createdAt])
  @@index([status])
  @@map("payments")
}

model Shipment {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        String    @map("order_id") @db.Uuid
  carrier        String?
  trackingNumber String?   @map("tracking_number")
  shippedAt      DateTime? @map("shipped_at")
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("shipments")
}

/// Replay protection for provider callbacks: the unique constraint makes
/// processing the same event twice impossible (ADR-012).
model WebhookEvent {
  id              String        @id @default(uuid()) @db.Uuid
  provider        String
  /// The provider's event id. The unique constraint below is the whole
  /// deduplication mechanism: a redelivery — a second, a third, or one that
  /// arrives concurrently — loses the insert and is ignored (P11 §11).
  externalEventId String        @map("external_event_id")
  /// The provider's event name, kept so a rejected or unhandled event can be
  /// explained without re-reading the payload.
  eventType       String?       @map("event_type")
  status          WebhookStatus @default(RECEIVED)
  /// Whether the signature verified. A row is written for rejected
  /// deliveries too — an attacker probing the endpoint is worth seeing —
  /// but a rejected event never touches a payment.
  signatureValid  Boolean       @default(false) @map("signature_valid")
  paymentId       String?       @map("payment_id") @db.Uuid
  /// Redacted, like `Payment.providerMetadata`: allowlisted keys only.
  payload         Json
  attempts        Int           @default(0)
  error           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  processedAt     DateTime?     @map("processed_at")

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([status])
  @@index([paymentId, createdAt])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// notifications
// ---------------------------------------------------------------------------

/// Written inside the business transaction, delivered after it commits, so a
/// notification is never sent for work that rolled back (ADR-013).
///
/// P13 is the first real consumer: `email-dispatcher.ts` claims `PENDING`
/// rows whose `type` it knows how to handle (`customer.email_verification_
/// requested`, `customer.password_reset_requested`) via an atomic
/// `UPDATE ... WHERE status = 'PENDING'`, attempts delivery, and transitions
/// to `SENT`, back to `PENDING` with `attempts`/`nextAttemptAt` advanced (a
/// transient failure, retried with backoff), or to `FAILED` (permanent, or
/// the retry budget is spent). Every other `type` already written by P10/P11
/// (`order.*`, `payment.*`) is left untouched — the dispatcher's claim query
/// filters by type, so those rows simply wait for whichever later phase
/// implements their delivery.
model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  type          String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error")
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at")
  sentAt        DateTime?    @map("sent_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

// ---------------------------------------------------------------------------
// content
// ---------------------------------------------------------------------------

/// A typed, ordered list of known section types — not a page builder
/// (ADR-014). `draftConfig` holds unpublished edits for preview.
model HomepageSection {
  id          String              @id @default(uuid()) @db.Uuid
  type        HomepageSectionType
  position    Int                 @default(0)
  enabled     Boolean             @default(true)
  config      Json                @default("{}")
  draftConfig Json?               @map("draft_config")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@index([position])
  @@map("homepage_sections")
}

// ---------------------------------------------------------------------------
// settings
// ---------------------------------------------------------------------------

/// Single row. Source of truth for store identity across storefront, admin,
/// checkout, receipts and emails (ADR-015).
model StoreSettings {
  id                  String   @id @default(uuid()) @db.Uuid
  storeNameAr         String   @map("store_name_ar")
  storeNameEn         String   @map("store_name_en")
  logoMediaId         String?  @map("logo_media_id") @db.Uuid
  logoDarkMediaId     String?  @map("logo_dark_media_id") @db.Uuid
  faviconMediaId      String?  @map("favicon_media_id") @db.Uuid
  brandColor          String   @default("#0D1B2A") @map("brand_color")
  brandColorSecondary String   @default("#D4AF37") @map("brand_color_secondary")
  currency            String   @default("SAR")
  defaultLocale       Locale   @default(AR) @map("default_locale")
  contact             Json     @default("{}")
  socialLinks         Json     @default("{}") @map("social_links")
  seoDefaults         Json     @default("{}") @map("seo_defaults")
  whatsappNumber      String?  @map("whatsapp_number")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

// ---------------------------------------------------------------------------
// analytics
// ---------------------------------------------------------------------------

/// Raw view events are pruned after 90 days; the daily rollup is what long
/// term reporting reads, so growth stays bounded (ADR-020).
model ProductView {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  sessionHash String   @map("session_hash")
  createdAt   DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([createdAt])
  @@map("product_views")
}

model DailyProductStats {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  date      DateTime @db.Date
  views     Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([date])
  @@map("daily_product_stats")
}
